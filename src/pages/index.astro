---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const byDate = (a, b) => b.data.pubDate - a.data.pubDate;
const notDraft = ({ data }) => !data.draft;

const blog = (await getCollection('blog', notDraft)).sort(byDate).slice(0, 3);
const allProjects = await getCollection('projects');
const featuredProjects = allProjects.filter((p) => p.data.featured);
const projects = (featuredProjects.length > 0 ? featuredProjects : allProjects).slice(0, 3);
---

<BaseLayout title="Home" description="Portfolio and blog by Rahul.">
  <h1>Rahul</h1>
  <p>Student of Data Science and Applications. Studying machine learning, deep learning and web development.</p>

  <h2>Projects</h2>
  <ul>
    {
      projects.map(({ data }) => (
        <li>
          <strong>{data.title}</strong> - {data.description}
          {data.liveUrl && <> (<a href={data.liveUrl}>demo</a>)</>}
          {data.repoUrl && <> (<a href={data.repoUrl}>code</a>)</>}
        </li>
      ))
    }
  </ul>

  <h2>Latest blog posts</h2>
  <ul>
    {blog.map((p) => <li><a href={`/blog/${p.id}`}>{p.data.title}</a></li>)}
  </ul>
</BaseLayout>
