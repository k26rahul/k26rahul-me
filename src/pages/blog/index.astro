---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicList from '../../components/TopicList.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate - a.data.pubDate,
);
---

<BaseLayout title="Blog" description="Longer-form writing.">
  <h1>Blog</h1>
  <ul>
    {
      posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}`}>{p.data.title}</a>
          <time datetime={p.data.pubDate.toISOString()}> {p.data.pubDate.toISOString().slice(0, 10)}</time>
          <p>{p.data.description}</p>
          <TopicList topics={p.data.tags} />
        </li>
      ))
    }
  </ul>
</BaseLayout>
