---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notDraft = ({ data }) => !data.draft;
  const entries = await getCollection('blog', notDraft);

  const topics = new Set(entries.flatMap((e) => e.data.tags));
  return [...topics].map((topic) => ({
    params: { topic },
    props: { entries: entries.filter((e) => e.data.tags.includes(topic)) },
  }));
}

const { topic } = Astro.params;
const { entries } = Astro.props;
---

<BaseLayout title={`#${topic}`} description={`Blog posts under topic ${topic}.`}>
  <h1>#{topic}</h1>
  <ul>
    {
      entries
        .sort((a, b) => b.data.pubDate - a.data.pubDate)
        .map((e) => (
          <li>
            <a href={`/blog/${e.id}`}>{e.data.title}</a>
          </li>
        ))
    }
  </ul>
</BaseLayout>
